{
  "name": "@subtitledb/core",
  "version": "0.5.10",
  "description": "Client for The Subtitle Database, a free subtitle API for films and series. No key needed. Lookups, matching, downloads and WebVTT conversion, with no dependencies. Runs in browsers and Node 20.3 or newer, as an ES module.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "subtitles",
    "subtitle",
    "srt",
    "vtt",
    "webvtt",
    "ass",
    "imdb",
    "tmdb",
    "api",
    "captions"
  ],
  "homepage": "https://thesubtitledb.org/developer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesubtitledb/subtitledb-integrations.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/thesubtitledb/subtitledb-integrations/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --force"
  }
}
