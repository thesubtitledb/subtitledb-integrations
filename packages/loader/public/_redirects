# Cloudflare Pages reads this from the root of the deployed directory.
#
# The entry file was sdb.js in 0.1.0 and subtitle-finder.js until 0.5.0. Both names
# were on a published snippet, so they answer permanently rather than 404 for anyone
# who copied one. Each points straight at the current name, never through the other,
# so a page pays one hop. Only the mutable /latest/ paths need this: an older
# /v/<ver>/ file is a real file that retain.mjs carries forward on every deploy, and
# it is served under an immutable header, so it must keep answering as itself and
# never as a redirect.
/latest/sdb.js                  /latest/subtitle-helper.js      301
/latest/sdb.esm.js              /latest/subtitle-helper.esm.js  301
/latest/subtitle-finder.js      /latest/subtitle-helper.js      301
/latest/subtitle-finder.esm.js  /latest/subtitle-helper.esm.js  301
