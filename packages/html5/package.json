{
  "name": "@subtitledb/html5",
  "version": "0.2.1",
  "description": "SubtitleDB subtitles for any HTML5 video element, including Plyr, Shaka and plain <video>. Converts to WebVTT in the browser.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@subtitledb/core": "0.4.0"
  }
}
