<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SubtitleDb.Jellyfin</AssemblyName>
    <RootNamespace>SubtitleDb.Jellyfin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.10 is the oldest release this builds against, and a plugin built against
         an older Controller loads in newer servers. PrivateAssets keeps the host's
         own assemblies out of the published plugin folder, where they would shadow
         the server's copies. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SubtitleDb.Core/SubtitleDb.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SubtitleDb.Jellyfin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
