<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- A warning in a plugin is a bug a user meets months later, in a log nobody
         reads. Cheaper to fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.5.0</Version>
    <!-- What changed in this version, in a sentence or two, for both hosts. Stamped
         into the assemblies; change it with the version. -->
    <PackageReleaseNotes>Jellyfin: two settings, off by default, keep a SYNCED - TSDb copy of each download lined up against a subtitle track inside the video or its audio. No change for Emby.</PackageReleaseNotes>
    <!-- What Jellyfin shows in its plugin catalog beside the update. Jellyfin only:
         an Emby-only change does not belong here. -->
    <JellyfinReleaseNotes>Two settings, off by default: Sync subtitles with other subtitle tracks, and Sync subtitles with audio. Each download then also gets a SYNCED - TSDb copy lined up with the video.</JellyfinReleaseNotes>
    <Authors>SubtitleDB</Authors>
    <Company>SubtitleDB</Company>
    <Product>SubtitleDB</Product>
    <!-- Stamped into every assembly. The Emby zip unpacks into a directory other
         plugins share, so the DLLs carry this rather than a LICENSE file. -->
    <Copyright>Copyright (c) 2026 TheSubtitleDb.org</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
