<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- A warning in a plugin is a bug a user meets months later, in a log nobody
         reads. Cheaper to fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.5.2</Version>
    <!-- What changed in this version, in a sentence or two, for both hosts. Stamped
         into the assemblies; change it with the version. -->
    <PackageReleaseNotes>Jellyfin: the subtitle found on play is in the list the player starts with, and no file is added or removed while a video plays. No change for Emby.</PackageReleaseNotes>
    <!-- What Jellyfin shows in its plugin catalog beside the update. Jellyfin only:
         an Emby-only change does not belong here. -->
    <JellyfinReleaseNotes>A TSDb subtitle found when you press play is in the subtitle list straight away. Picking a subtitle no longer fails after TSDb saves a file mid-play: no file is added or removed while a video plays.</JellyfinReleaseNotes>
    <Authors>SubtitleDB</Authors>
    <Company>SubtitleDB</Company>
    <Product>SubtitleDB</Product>
    <!-- Stamped into every assembly. The Emby zip unpacks into a directory other
         plugins share, so the DLLs carry this rather than a LICENSE file. -->
    <Copyright>Copyright (c) 2026 TheSubtitleDb.org</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
