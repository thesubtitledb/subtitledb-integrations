{
  "name": "subtitledb-integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Subtitle integrations for web video players, media servers and desktop players, backed by the SubtitleDB open API.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/artplayer packages/html5 packages/players packages/subbot packages/debug packages/loader",
    "typecheck": "node scripts/check-no-stray-build.mjs && tsc -b packages/core packages/artplayer packages/html5 packages/players packages/subbot packages/debug packages/loader --force",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "vendor": "node scripts/make-sample-video.mjs && node scripts/make-licences.mjs && node scripts/vendor-examples.mjs",
    "e2e": "playwright test",
    "bench:ia": "playwright test --config playwright.bench.config.ts",
    "serve": "node scripts/serve-examples.mjs",
    "build:cdn": "npm run build --workspace @subtitledb/loader && node packages/loader/build.mjs",
    "retain:cdn": "node packages/loader/retain.mjs",
    "serve:cdn": "node scripts/serve-cdn.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@clappr/player": "^0.14.9",
    "@flowplayer/player": "^3.43.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "artplayer": "^5.2.5",
    "bitmovin-player": "^8.282.0",
    "dashjs": "^5.2.1",
    "dplayer": "^1.27.1",
    "esbuild": "^0.28.2",
    "fluid-player": "^3.61.0",
    "hls.js": "^1.7.4",
    "media-chrome": "^4.19.4",
    "mediaelement": "^7.1.0",
    "nplayer": "^1.0.15",
    "openplayerjs": "^2.14.12",
    "plyr": "^3.8.5",
    "shaka-player": "^5.3.3",
    "theoplayer": "^11.14.1",
    "typescript": "^7.0.2",
    "video.js": "^10.2.0",
    "vidstack": "^1.15.7",
    "vitest": "^5.0.5",
    "xgplayer": "^3.0.27"
  }
}
